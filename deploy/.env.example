# DockPulse controller — default .env (no bundled reverse proxy).
#
# Used by `deploy/docker-compose.yml`. Copy to `.env` and edit.
# If you also use the optional Caddy bundle
# (`deploy/docker-compose.with-caddy.yml`), set the Caddy-specific
# variables there too.

# Image tag to run. Default is `latest`; pin to a specific version
# (e.g. v0.1.0) in production.
DOCKPULSE_IMAGE_TAG=latest

# Log level for the controller: debug | info | warn | error.
DOCKPULSE_LOG_LEVEL=info

# Name of the Docker network your reverse proxy already uses. The
# controller will be attached to this network so the reverse proxy
# can reach it as `controller:8080`.
DOCKPULSE_PROXY_NETWORK=dockpulse_proxy

# Comma-separated list of trusted reverse-proxy IPs (CIDR or single
# address) for chi's RealIP middleware. If empty, X-Forwarded-For is
# ignored. Recommended: set this to the address of your reverse
# proxy so client IPs in audit logs and rate limits are accurate.
#
# Examples:
#   DOCKPULSE_TRUSTED_PROXIES=172.18.0.5
#   DOCKPULSE_TRUSTED_PROXIES=172.18.0.0/16,10.0.0.0/8
DOCKPULSE_TRUSTED_PROXIES=