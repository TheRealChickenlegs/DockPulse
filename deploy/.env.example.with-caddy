# DockPulse controller + Caddy — optional bundled reverse proxy.
#
# Used by `deploy/docker-compose.with-caddy.yml`. Copy to `.env`
# and edit. The default controller .env (deploy/.env.example) is
# also used; this file only adds the Caddy-specific variables.

# Domain the controller is served on. DNS must point at this host
# and ports 80/443 must be reachable from the internet.
DOCKPULSE_DOMAIN=dockpulse.example.com

# Email for ACME (Let's Encrypt) registration. Optional but
# recommended so you receive certificate expiry notices.
DOCKPULSE_ACME_EMAIL=ops@example.com

# Image tag to run.
DOCKPULSE_IMAGE_TAG=latest

# Log level: debug | info | warn | error.
DOCKPULSE_LOG_LEVEL=info